# Ejemplo: virtual host propio que pide el certificado digital (certificado de
# cliente TLS) para la página cert_login. Sirve la aplicación entera, porque
# los formularios de esa página (documentos y voto) se envían al mismo host.
# Con config: "clientcert_enabled" => true,
#             "clientcert_url" => "https://cert.example.org/cert_login"
<VirtualHost *:443>
    ServerName cert.example.org
    DocumentRoot /var/www/html

    SSLEngine on
    SSLCertificateFile    /etc/ssl/certs/cert.example.org.pem
    SSLCertificateKeyFile /etc/ssl/private/cert.example.org.key

    # Autoridades admitidas (raíces e intermedias): el mismo fichero que
    # clientcert_ca_file, que PHP vuelve a comprobar.
    SSLCACertificateFile /var/www/html/certs/clientcert_ca.pem
    # optional: sin certificado la página explica qué pasa en lugar de
    # cortar la conexión.
    SSLVerifyClient optional
    SSLVerifyDepth 3
    # Revocación: la comprueba PHP (clientcert_revocation), por OCSP y, si
    # no responde, con la CRL del certificado. Con SSLOCSPEnable una caída
    # del OCSP de la autoridad impediría identificarse.
    SSLOCSPEnable off

    # SSL_CLIENT_VERIFY y SSL_CLIENT_CERT para PHP. En todo el host y no en
    # <Location /cert_login>: el .htaccess reescribe la petición a index.php.
    SSLOptions +StdEnvVars +ExportCertData

    # Este host pide el certificado al conectar: solo sirve para identificarse
    # y votar. El resto de páginas vuelve al sitio normal (clientcert no).
    RewriteEngine On
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} !^/(cert_login|participate)/?$
    RewriteCond %{REQUEST_URI} !^/(css|js|fonts|img)/
    RewriteRule ^ https://www.example.org%{REQUEST_URI} [R=302,L]

    <Directory /var/www/html>
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>

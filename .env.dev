# Copiar a .env y ajustar. docker compose lo lee automaticamente.
WEB_PORT=8080

DB_NAME=mlsurvey
DB_USER=mlsurvey
DB_PASSWORD=cambiame
DB_ROOT_PASSWORD=cambiame-root
DB_PREFIX=

# Pool de conexiones: un worker de Apache = una conexion persistente.
# DB_MAX_CONNECTIONS debe superar APACHE_MAX_WORKERS (cada worker usa ~30-50MB de RAM).
APACHE_MAX_WORKERS=150
APACHE_START_WORKERS=25
APACHE_MAX_SPARE_WORKERS=75
APACHE_LISTEN_BACKLOG=1024
DB_MAX_CONNECTIONS=200

# URL publica del sitio (esquema, host, puerto y ruta). Los enlaces para
# verificar la cuenta que se envian por correo se construyen con ella.
SITE_URL=https://localhost:8443/

# 0: error, 1: warn, 2: info, 3: debug.
LOG_LEVEL=3

# Envio de correo. EMAIL_METHOD: SMTP o Sendmail.
# EMAIL_ENCRYPTION: tls (STARTTLS), ssl, o none para SMTP sin cifrar.
#
# Tal cual esta, apunta al servicio «mail» del docker-compose, un Postfix
# sin salida a internet que entrega todo a un buzon local:
#
#   docker compose exec mail mlmail       lista los mensajes recibidos
#   docker compose exec mail mlmail 1     muestra el primero entero
#   docker compose exec mail mlmail -c    vacia el buzon
#
# EMAIL_USER da igual, se acepta cualquiera. EMAIL_PASSWORD si importa:
# es la clave que el servicio mail exige (le llega como MAIL_PASSWORD).
EMAIL_METHOD=SMTP
EMAIL_SERVER=mail
EMAIL_PORT=587
EMAIL_USER=mlsurvey
EMAIL_PASSWORD=mlsurvey
EMAIL_FROM=mlsurvey@example.test
EMAIL_ENCRYPTION=none

# Para un servidor real, sustituye lo de arriba por algo asi y el
# servicio «mail» del compose deja de usarse:
#   EMAIL_SERVER=smtp.tuservidor.org
#   EMAIL_PORT=587
#   EMAIL_USER=avisos@tudominio.org
#   EMAIL_PASSWORD=...
#   EMAIL_FROM=avisos@tudominio.org
#   EMAIL_ENCRYPTION=tls

# Captcha ALTCHA en el formulario de solicitud de participacion.
# Resuelve una prueba de trabajo en el navegador, que necesita Web Crypto:
# solo esta disponible en contextos seguros (HTTPS o localhost), asi que
# con la aplicacion servida por HTTP en otra maquina hay que ponerlo a false.
# ALTCHA_HMAC_KEY firma los retos; vacia, se genera una clave por sesion.
ALTCHA_ENABLED=true
ALTCHA_HMAC_KEY=

# Clave del HMAC con el que se guardan el correo y el DNI de las participantes.
# Obligatoria. Generala una vez (openssl rand -hex 32) y no la cambies: con
# otra clave ninguna participante registrada se reconoce. Los hashes de
# test-data.sql estan calculados con este valor de desarrollo.
PARTICIPANT_HMAC_KEY=cambiame

# Certificado electronico al registrarse (el DNI del documento tiene que ser
# el del certificado) y al votar (identifica a quien vota). El navegador solo lo pide por HTTPS: el contenedor lo
# sirve en WEB_SSL_PORT (https://localhost:8443) con un certificado
# autofirmado, y las CA admitidas salen de la TSL espanola. Por HTTP
# (WEB_PORT) no se puede registrar nadie.
# Con un proxy TLS delante que lo verifique el, las variables son las
# cabeceras donde pase el resultado ("SUCCESS") y el certificado (PEM o PEM
# URL-encoded), p. ej. HTTP_X_SSL_CLIENT_VERIFY y HTTP_X_SSL_CLIENT_CERT; el
# proxy tiene que sobrescribirlas siempre o cualquiera mandaria las suyas.
# false desactiva la comprobacion (solo desarrollo): al votar se pide el DNI
# (en test-data.sql, 00000000T es una cuenta verificada).
WEB_SSL_PORT=8443
# Registro y votacion: el unico sitio que pide el certificado electronico.
WEB_REG_PORT=8444
REGISTRATION_URL=https://localhost:8444/
# HTTP (WEB_PORT) redirige a SITE_URL, que tiene que ser https://. false si
# un proxy TLS llega al contenedor por HTTP.
HTTPS_REDIRECT=true
CLIENT_CERT_ENABLED=true
CLIENT_CERT_VERIFY_VAR=SSL_CLIENT_VERIFY
CLIENT_CERT_VAR=SSL_CLIENT_CERT
# PEM con CA raiz que la TSL no trae (ruta dentro del contenedor).
CLIENT_CA_EXTRA=

ADMIN_USER=admin
ADMIN_PASSWORD=cambiame

# Restringir la edición de consultas a quien las creó.
SURVEY_EDIT_RESTRIC=false


# Copiar a .env y ajustar. docker compose lo lee automaticamente.
WEB_PORT=8080

DB_NAME=mlsurvey
DB_USER=mlsurvey
DB_PASSWORD=cambiame
DB_ROOT_PASSWORD=cambiame-root
DB_PREFIX=

# Pool de conexiones: un worker de Apache = una conexion persistente.
# DB_MAX_CONNECTIONS debe superar APACHE_MAX_WORKERS (cada worker usa ~30-50MB de RAM).
APACHE_MAX_WORKERS=150
APACHE_START_WORKERS=25
APACHE_MAX_SPARE_WORKERS=75
APACHE_LISTEN_BACKLOG=1024
DB_MAX_CONNECTIONS=200

PROXY_PATH=
PROXY_PORT=

LOG_LEVEL=0

# Envio de correo. EMAIL_METHOD: SMTP o Sendmail.
# EMAIL_ENCRYPTION: tls (STARTTLS), ssl, o none para SMTP sin cifrar.
#
# Tal cual esta, apunta al servicio «mail» del docker-compose, un Postfix
# sin salida a internet que entrega todo a un buzon local:
#
#   docker compose exec mail mlmail       lista los mensajes recibidos
#   docker compose exec mail mlmail 1     muestra el primero entero
#   docker compose exec mail mlmail -c    vacia el buzon
#
# EMAIL_USER da igual, se acepta cualquiera. EMAIL_PASSWORD si importa:
# es la clave que el servicio mail exige (le llega como MAIL_PASSWORD).
EMAIL_METHOD=SMTP
EMAIL_SERVER=mail
EMAIL_PORT=587
EMAIL_USER=mlsurvey
EMAIL_PASSWORD=mlsurvey
EMAIL_FROM=mlsurvey@example.test
EMAIL_ENCRYPTION=none

# Para un servidor real, sustituye lo de arriba por algo asi y el
# servicio «mail» del compose deja de usarse:
#   EMAIL_SERVER=smtp.tuservidor.org
#   EMAIL_PORT=587
#   EMAIL_USER=avisos@tudominio.org
#   EMAIL_PASSWORD=...
#   EMAIL_FROM=avisos@tudominio.org
#   EMAIL_ENCRYPTION=tls

# Captcha ALTCHA en el formulario de solicitud de participacion.
# Resuelve una prueba de trabajo en el navegador, que necesita Web Crypto:
# solo esta disponible en contextos seguros (HTTPS o localhost), asi que
# con la aplicacion servida por HTTP en otra maquina hay que ponerlo a false.
# ALTCHA_HMAC_KEY firma los retos; vacia, se genera una clave por sesion.
ALTCHA_ENABLED=true
ALTCHA_HMAC_KEY=

ADMIN_USER=admin
ADMIN_PASSWORD=cambiame

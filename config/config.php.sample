<?php
const CONFIG = [
"db_host" => 'host ip',
"db_name" => 'database name',
"db_user"=>'database user',
"db_pass"=>'database password',
"db_port"=>3306,
//$db_port='/run/mysqld/mysqld.sock',
"db_prefix"=>'',

/**
 * Public URL of the site, as participants reach it (scheme, host, port and
 * path, e.g. "https://consultas.example.org/mlsurvey/"). The account
 * verification links sent by email are built from it. It is mandatory: the Host header of
 * the request can't be trusted for that.
 */
"site_url"=>"",

/**
 * URL of the registration and voting (e.g. "https://registro.consultas.example.org/"):
 * the only virtual host that asks for the client certificate (see
 * client_cert_*), which identifies the participant when registering and when
 * voting. It serves the same application. It must be the host of site_url in
 * another port or a subdomain of it (the session cookie has to reach both).
 * Empty: registering and voting are done in site_url, which then has to ask
 * for the certificate itself.
 */
"registration_url"=>"",


/**
 * For logging
 */
"log_level"=>0, //0: error, 1: warn, 2: info, 3: debug.

/**
 * For email server configuration
 */

"email_method" => "SMTP", //STMP or Sendmail
"email_server" => "email server address",
"email_port" => 587,
"email_user" => "email server user", //Server user
"email_password" => "email server password", //Server password
"email_from" => "email from for messages", //Sender address
"email_encryption" => "tls", //ssl or tls for starttls.

/**
 * Altcha captcha, used in the participation request form.
 * It needs Web Crypto in the browser, only available on secure contexts
 * (HTTPS or localhost): set it to false on a plain HTTP installation.
 * altcha_hmac_key signs the challenges; leave it empty and a per session
 * key is generated instead.
 */

"altcha_enabled" => true,
"altcha_hmac_key" => '',

/**
 * Key of the HMAC that hashes the email addresses and DNIs of the participants.
 * It is mandatory: generate it once (e.g. with "openssl rand -hex 32") and keep it,
 * changing or losing it makes every registered participant unrecognizable.
 */

"participant_hmac_key" => '',

/**
 * Documents asked for participating: the appointment (nombramiento), the
 * teaching credential, the service record (hoja de servicios) or the payslip
 * (nómina). Their signature is not checked (they may be signed by hand or not
 * signed): only their content. The appointment and the credential must be of
 * the current school year.
 * pdf_max_age_days: how old the service record can be, counting from its
 * issue date.
 * It needs the pdftotext, pdfinfo and pdftoppm (poppler-utils) commands.
 */

"pdf_max_age_days" => 30,

/**
 * Client certificate (certificado digital: FNMT, DNI electronico...) asked
 * when registering, where the DNI of the uploaded document must be the one of
 * the certificate, and when voting, where it identifies the participant. Only the registration_url virtual host should ask for it. The web server verifies the certificate chain (SSLVerifyClient
 * with the CAs accepted in SSLCACertificateFile) and passes the result and the
 * certificate in these $_SERVER variables. Make the CA file, with every
 * qualified CA of the Spanish Trusted List, with buildclientca.php. By default the ones of Apache
 * mod_ssl with "SSLOptions +StdEnvVars +ExportCertData". Behind a TLS proxy
 * use the headers it sets, e.g. HTTP_X_SSL_CLIENT_VERIFY and
 * HTTP_X_SSL_CLIENT_CERT (PEM or URL-encoded PEM): the proxy must always
 * overwrite them, or anyone could send their own.
 * client_cert_enabled: set it to false only for development.
 */
"client_cert_enabled" => true,
"client_cert_verify_var" => "SSL_CLIENT_VERIFY",
"client_cert_var" => "SSL_CLIENT_CERT",

/**
 * For enabling stress test bypasses
 */

"ml_stresstest" => false,

/**
 * For restrict permissions on survey edition.
 * true: only creator can edit a survey
 * false: every user can edit a survey.
 */
"survey_edit_restric" => false,

/**
 * For using the default icon when no icon is defined
 */
"use_default_icon" => true,
];
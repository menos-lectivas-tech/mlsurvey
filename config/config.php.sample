const CONFIG = [
"db_host" => 'host ip',
"db_name" => 'database name',
"db_user"=>'database user',
"db_pass"=>'database password',
"db_port"=>3306,
//$db_port='/run/mysqld/mysqld.sock',
"db_prefix"=>'',

/**
 * Public URL of the site, as participants reach it (scheme, host, port and
 * path, e.g. "https://consultas.example.org/mlsurvey/"). The participation
 * links sent by email are built from it. It is mandatory: the Host header of
 * the request can't be trusted for that.
 */
"site_url"=>"",


/**
 * For logging
 */
"log_level"=>0, //0: error, 1: warn, 2: info, 3: debug.

/**
 * For email server configuration
 */

"email_method" => "SMTP", //STMP or Sendmail
"email_server" => "email server address",
"email_port" => 587,
"email_user" => "email server user", //Server user
"email_password" => "email server password", //Server password
"email_from" => "email from for messages", //Sender address
"email_encryption" => "tls", //ssl or tls for starttls.

/**
 * Altcha captcha, used in the participation request form.
 * It needs Web Crypto in the browser, only available on secure contexts
 * (HTTPS or localhost): set it to false on a plain HTTP installation.
 * altcha_hmac_key signs the challenges; leave it empty and a per session
 * key is generated instead.
 */

"altcha_enabled" => true,
"altcha_hmac_key" => '',

/**
 * Key of the HMAC that hashes the email addresses and DNIs of the participants.
 * It is mandatory: generate it once (e.g. with "openssl rand -hex 32") and keep it,
 * changing or losing it makes every registered participant unrecognizable.
 */

"participant_hmac_key" => '',

/**
 * Signed training record PDF (extracto de formación) asked for participating.
 * pdf_ca_file: PEM file with the certification authorities trusted for the
 * signature. Only these are trusted, not the system ones.
 * pdf_signer_ids: serialNumber (NIF) of the certificates allowed to sign the
 * PDF. S7800001E is the Comunidad de Madrid electronic seal.
 * It needs the openssl and pdftotext (poppler-utils) commands.
 */

"pdf_ca_file" => 'certs/extracto_ca.pem',
"pdf_signer_ids" => ['S7800001E'],

/**
 * Second PDF asked for participating: the digitally signed MUFACE membership
 * certificate (Clases Pasivas) or the digitally signed appointment,
 * nombramiento (the rest: career civil servants who joined from 2011 on and
 * interim ones).
 * muface_ca_file: PEM file with the certification authorities trusted for the
 * signature of the MUFACE certificate. Only these are trusted, not the system
 * ones.
 * muface_signer_ids: serialNumber (NIF) of the certificates allowed to sign
 * it. Q2861001B is the MUFACE electronic seal.
 * pdf_max_age_days: how old the MUFACE certificate can be, counting from its
 * issue date. The appointment must be of the current school year.
 * nombramiento_ca_file: PEM file with the certification authorities trusted
 * for the signature of the appointment, the service record (hoja de
 * servicios) and the teaching credential.
 * nombramiento_signer_orgs: regular expression the organizationIdentifier of
 * the signer's certificate must match (they are signed with the personal
 * certificate of a public employee or the representative certificate of the
 * school): the Comunidad de Madrid (S7800001E) and the public bodies of Madrid
 * (NIF Q with province code 28 or 78 to 88).
 * The service record and the credential must be signed in the current school
 * year, and the service record not longer than pdf_max_age_days ago.
 */

"muface_ca_file" => 'certs/muface_ca.pem',
"muface_signer_ids" => ['Q2861001B'],
"pdf_max_age_days" => 30,
"nombramiento_ca_file" => 'certs/nombramiento_ca.pem',
"nombramiento_signer_orgs" => '/^VATES-(S7800001E|Q(28|7[89]|8[0-8])[0-9]{5}[A-Z])$/',

/**
 * For enabling stress test bypasses
 */

"ml_stresstest" => false,

/**
 * For restrict permissions on survey edition.
 * true: only creator can edit a survey
 * false: every user can edit a survey.
 */
"survey_edit_restric" => false,

/**
 * For using the default icon when no icon is defined
 */
"use_default_icon" => true,
];
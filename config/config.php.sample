<?php
const CONFIG = [
"db_host" => 'host ip',
"db_name" => 'database name',
"db_user"=>'database user',
"db_pass"=>'database password',
"db_port"=>3306,
//$db_port='/run/mysqld/mysqld.sock',
"db_prefix"=>'',

/**
 * Public URL of the site, as participants reach it (scheme, host, port and
 * path, e.g. "https://consultas.example.org/mlsurvey/"). The participation
 * links sent by email are built from it. It is mandatory: the Host header of
 * the request can't be trusted for that.
 */
"site_url"=>"",


/**
 * For logging
 */
"log_level"=>0, //0: error, 1: warn, 2: info, 3: debug.

/**
 * For email server configuration
 */

"email_method" => "SMTP", //STMP or Sendmail
"email_server" => "email server address",
"email_port" => 587,
"email_user" => "email server user", //Server user
"email_password" => "email server password", //Server password
"email_from" => "email from for messages", //Sender address
"email_encryption" => "tls", //ssl or tls for starttls.

/**
 * Altcha captcha, used in the participation request form.
 * It needs Web Crypto in the browser, only available on secure contexts
 * (HTTPS or localhost): set it to false on a plain HTTP installation.
 * altcha_hmac_key signs the challenges; leave it empty and a per session
 * key is generated instead.
 */

"altcha_enabled" => true,
"altcha_hmac_key" => '',

/**
 * Key of the HMAC that hashes the email addresses and DNIs of the participants.
 * It is mandatory: generate it once (e.g. with "openssl rand -hex 32") and keep it,
 * changing or losing it makes every registered participant unrecognizable.
 */

"participant_hmac_key" => '',

/**
 * Signed self-declaration asked for registering (docs/modelo_declaracion.pdf):
 * a PDF form with the DNI/NIE and the email address of the participant,
 * signed with their own personal certificate. The DNI of the form must be the
 * one of the certificate. It needs the openssl, pdftotext (poppler-utils) and
 * qpdf commands.
 * declaracion_ca_file: PEM file with the certification authorities (roots and
 * intermediates) trusted for the signer's certificate. Only these are
 * trusted, not the system ones.
 * declaracion_revocation: checks that the signer's certificate isn't revoked,
 * with OCSP and, if the responder doesn't answer, with the CRL of the
 * certificate (see utils/certrevocation.php). Turn it off only for tests.
 * declaracion_email_domains: domains allowed for the email address of the
 * declaration (empty: any).
 */

"declaracion_ca_file" => 'certs/declaracion_ca.pem',
"declaracion_revocation" => true,
"declaracion_email_domains" => ['educa.madrid.org'],

/**
 * For enabling stress test bypasses
 */

"ml_stresstest" => false,

/**
 * For restrict permissions on survey edition.
 * true: only creator can edit a survey
 * false: every user can edit a survey.
 */
"survey_edit_restric" => false,

/**
 * For using the default icon when no icon is defined
 */
"use_default_icon" => true,
];